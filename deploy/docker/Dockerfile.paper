FROM eclipse-temurin:21-jre-noble

ARG PAPER_VERSION=1.21
ARG PAPER_BUILD=latest
ARG PAPER_JAR=deploy/docker/downloads/paper.jar

# The Paper server jar is downloaded on the CI runner by deploy/docker/download-paper.sh
# because the fill.papermc.io API is unreliably served inside the BuildKit container.
COPY ${PAPER_JAR} /opt/paper.jar

COPY deploy/config/server.properties /opt/server.properties
COPY deploy/config/paper-global.yml /opt/paper-global.yml
COPY plugins/paper/build/libs/rampart-paper-*.jar /opt/plugins/

EXPOSE 25566

WORKDIR /opt
CMD ["java", "-jar", "/opt/paper.jar", "--nogui"]
